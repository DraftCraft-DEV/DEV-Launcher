# Maintainer: DraftCraft Engineering Ventures
# Generated by the release workflow from packaging/aur/PKGBUILD.in.
pkgname=dev-launcher-bin
pkgver=@PKGVER@
_tag=v@VERSION@
pkgrel=1
pkgdesc="Install, update and launch the DraftCraft Engineering Ventures apps"
arch=('x86_64' 'aarch64')
url="https://github.com/@REPO@"
license=('Apache-2.0')
depends=('glibc' 'gcc-libs' 'libglvnd' 'libxkbcommon' 'libx11' 'libxcursor' 'libxrandr' 'libxi' 'hicolor-icon-theme')
optdepends=('wayland: native Wayland window'
            'polkit: install apps as system packages')
provides=('dev-launcher')
conflicts=('dev-launcher')
source_x86_64=("dev-launcher-${pkgver}-x86_64.tar.gz::${url}/releases/download/${_tag}/dev-launcher-linux-x86_64.tar.gz")
source_aarch64=("dev-launcher-${pkgver}-aarch64.tar.gz::${url}/releases/download/${_tag}/dev-launcher-linux-aarch64.tar.gz")
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
  cd dev-launcher
  install -Dm755 dev-launcher "$pkgdir/usr/bin/dev-launcher"
  install -Dm644 dev-launcher.desktop "$pkgdir/usr/share/applications/dev-launcher.desktop"
  for s in 16 32 48 64 128 256 512; do
    install -Dm644 "icons/app-icon-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/dev-launcher.png"
  done
  install -Dm644 icons/app-icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev-launcher.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
